{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (MSVC, vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "cross",
      "displayName": "Compile check on macOS or Linux (clang-cl, xwin)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cross",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "VCPKG_TARGET_TRIPLET": "x64-windows-clangcl",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cross/triplets",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cross/ports",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cross/toolchain.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cross",
      "configurePreset": "cross"
    }
  ]
}
