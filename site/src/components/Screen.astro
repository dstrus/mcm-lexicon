---
// A screen of the app, captured in both themes; the page shows the one that
// matches its own.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	dark: ImageMetadata;
	light: ImageMetadata;
	alt: string;
	eager?: boolean;
}
const { dark, light, alt, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const widths = [720, 1440, 2160, 2880];
const sizes = '(min-width: 75rem) 62vw, 100vw';
---

<div class="screen">
	<Image class="dark" src={dark} alt={alt} widths={widths} sizes={sizes} loading={loading} format="webp" quality={82} />
	<Image class="light" src={light} alt={alt} widths={widths} sizes={sizes} loading={loading} format="webp" quality={82} />
</div>

<style>
	.screen {
		border: 1px solid var(--rule-strong);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--ground);
	}
	.light {
		display: none;
	}
	:global(:root[data-theme='light']) .dark {
		display: none;
	}
	:global(:root[data-theme='light']) .light {
		display: block;
	}
	@media (prefers-color-scheme: light) {
		:global(:root:not([data-theme='dark'])) .dark {
			display: none;
		}
		:global(:root:not([data-theme='dark'])) .light {
			display: block;
		}
	}
</style>
