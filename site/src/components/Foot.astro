---
// The footer: who made it, what it isn't, and where else to go.
import Mark from './Mark.astro';
import { repository, releases, issues, license } from '../links';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="foot">
	<Mark size="2.5rem" />
	<div class="legal">
		<p class="who">
			Made by Davey, a software engineer for somewhere in the neighborhood of a quarter-century. I like Skyrim VR so much that I sometimes make tools
			to avoid actually launching it.
		</p>
		<p>
			MCM Lexicon works with MCM Recorder but isn’t part of it, and isn’t affiliated with MCM Recorder, SkyUI, MCM Helper, or Mod Organizer. It includes
			none of their files.
		</p>
		<p><a href="https://www.nexusmods.com/skyrimspecialedition/mods/31374" target="_blank">WeaponThrowVR</a> is by Shizof, and its menu appears here with Shizof’s permission. (It's also really fun.)</p>
		<p>The Elder Scrolls V: Skyrim is a trademark of ZeniMax Media Inc.</p>
		<p>Released under the <a href={license}>MIT License</a>. Copyright © 2026 Davey Strus.</p>
	</div>
	<nav class="links caps" aria-label="Elsewhere">
		<a href={`${base}/docs/`}>Docs</a>
		<a href={repository}>Source</a>
		<a href={releases}>Releases</a>
		<a href={issues}>Issues</a>
	</nav>
</footer>

<style>
	.foot {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: var(--space-6);
		align-items: start;
		margin-top: var(--space-9);
		padding: var(--space-7) var(--gutter) 6rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: var(--step--1);
	}
	.legal {
		display: grid;
		gap: var(--space-2);
		max-width: 70ch;
	}
	.who {
		color: var(--ink);
	}
	.links {
		display: flex;
		gap: var(--space-5);
		font-size: var(--step-0);
	}
	@media (max-width: 60rem) {
		.foot {
			grid-template-columns: minmax(0, 1fr);
			padding-bottom: var(--space-7);
		}
	}
</style>
