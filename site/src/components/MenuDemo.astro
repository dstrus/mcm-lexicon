---
// The hero: MCM Lexicon's own window, running. Its top bar with the list
// it's reading and a RECORDING lamp counting the draft, WeaponThrowVR's
// real menu as the app draws it, the step file it writes as the app's
// details pane, and the app's hint strip along the bottom with working
// keys. Every value the visitor sets lands in the file as MCM Recorder
// reads it. Nothing leaves the page. The menu's data is made by scanning
// the Synergy list (src/data/weaponthrowvr.json), shown with its author's
// permission; the list and profile named in the bar are that snapshot's.
import Diamond from './Diamond.astro';
import Mark from './Mark.astro';
import menu from '../data/weaponthrowvr.json';
import { stepFile, type Step } from '../lib/steps';

type Row = {
	kind: string;
	label?: string;
	text?: string;
	position: number;
	help?: string;
	default?: number | boolean | string;
	slider?: { min: number; max: number; step: number; format: string };
	choices?: string[];
	value?: string;
};

// The menu opens at the top of General with the first toggle recorded and
// selected, and the toggle whose label is spelled as the mod spells it
// recorded further down the page, so the file holds the typo from the
// start.
const start = menu.pages.findIndex((p) => p.name === 'General');
const steps: Step[] = [
	{ page: 'General', option: 'Allow Dagger Throw', kind: 'toggle', value: 'on' },
	{ page: 'General', option: 'Allow Greanade and Other Throw', kind: 'toggle', value: 'on' }
];
const selected = { page: 'General', option: 'Allow Dagger Throw' };
// The invitation sits on a switch not recorded yet, two rows under the
// selected one, so the visitor's first flip adds a step and the lamp counts
// up. An axe, since every player knows what one is.
const invite = { page: 'General', option: 'Allow Axe Throw' };

// A slider's value as SkyUI shows it: {1} is one decimal place.
function shown(n: number, format = '') {
	const m = /\{(\d)\}/.exec(format);
	return m ? format.replace(m[0], n.toFixed(Number(m[1]))) : String(n);
}
const kinds: Record<string, string> = { toggle: 'Toggle', slider: 'Slider', menu: 'Menu', text: 'Text' };
function allows(r: Row) {
	if (r.slider) return `${r.slider.min} to ${r.slider.max} by ${r.slider.step}`;
	if (r.kind === 'toggle') return 'On or off';
	if (r.choices) return `${r.choices.length} choices`;
	if (r.kind === 'text') return 'A click';
	return '';
}
function recorded(page: string, r: Row) {
	return steps.find((s) => s.page === page && s.option === r.label);
}
const first = menu.pages[start].rows.find((r: Row) => r.label === selected.option) as Row;
---

<div class="live" data-live>
	<div class="demo" data-demo data-mod={menu.name} data-steps={JSON.stringify(steps)} data-kind={first.kind}>
	<div class="bar">
		<p class="brand caps"><Mark size="1.2em" /> MCM Lexicon</p>
		<div class="state">
			<p class="source"><span class="caps">List</span> <span class="file-name">synergy-rc37</span></p>
			<p class="source profile"><span class="caps">Profile</span> Synergy VR - ENB</p>
			<p class="game caps">Skyrim closed</p>
			<p class="lamp caps" role="status">
				<svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0 10 5 5 10 0 5Z" fill="currentColor"></path></svg>
				Recording <span class="count-wrap">· <b data-count>{steps.length}</b> steps</span>
			</p>
		</div>
	</div>
	<div class="shell">
	<div class="menu">
		<div class="head">
			<p class="name caps">{menu.name}</p>
			<p class="meta">{menu.mod} · {menu.plugin}</p>
			<p class="credit caps">By Shizof, shown with permission</p>
		</div>
		<div class="body">
			<ul class="pages caps" aria-label="Pages">
				{
					menu.pages.map((p, i) => (
						<li>
							<button type="button" data-page={i} aria-current={i === start ? 'page' : undefined}>
								<span class="slot"><Diamond /></span>
								<span class="pname">{p.name}</span>
								<span class="count">{p.rows.filter((r: Row) => r.kind !== 'header').length}</span>
							</button>
						</li>
					))
				}
			</ul>
			<div class="options" data-options>
				{
					menu.pages.map((p, i) => (
						<div class="grid" data-grid={i} data-name={p.name} hidden={i !== start}>
							{(p.rows as Row[]).map((r) => {
								const style = `--r: ${Math.floor(r.position / 2) + 1}; --c: ${(r.position % 2) + 1}`;
								if (r.kind === 'header') {
									return (
										<p class="header caps" style={style}>
											{r.text}
										</p>
									);
								}
								const step = recorded(p.name, r);
								const sel = p.name === selected.page && r.label === selected.option;
								return (
									<div
										class:list={['row', { sel, rec: step }]}
										style={style}
										data-kind={r.kind}
										data-label={r.label}
										data-help={r.help}
										data-allows={allows(r)}
										data-type={kinds[r.kind]}
										data-default={r.default === undefined ? undefined : String(r.default)}
									>
										<span class="slot">
											<Diamond />
										</span>
										<span class="label">{r.label}</span>
										<span class="value">
										{p.name === invite.page && r.label === invite.option && (
											<button type="button" class="invite caps" data-invite>
												Flip<span class="this"> this</span>
												<svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true"><path d="M1 5h9M7 1.5 10.5 5 7 8.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
											</button>
										)}
										<span class="mark" title="In the draft, not saved yet">
											<svg width="7" height="7" viewBox="0 0 10 10" aria-hidden="true">
												<path d="M5 0 10 5 5 10 0 5Z" fill="currentColor" />
											</svg>
										</span>
										{r.kind === 'toggle' && (
											<button
												type="button"
												role="switch"
												class:list={['switch', { unset: !step }]}
												aria-checked={step?.value === 'on' ? 'true' : 'false'}
												aria-label={r.label}
											>
												<span class="knob" />
											</button>
										)}
										{r.kind === 'slider' && r.slider && (
											<>
												<input
													class="range"
													type="range"
													tabindex="-1"
													aria-hidden="true"
													min={r.slider.min}
													max={r.slider.max}
													step={r.slider.step}
													value={step ? step.value : r.default}
												/>
												<input
													class:list={['num', 'field', { changed: step && r.default !== undefined && step.value !== r.default }]}
													type="number"
													inputmode="decimal"
													min={r.slider.min}
													max={r.slider.max}
													step={r.slider.step}
													value={shown(Number(step ? step.value : (r.default ?? r.slider.min)), r.slider.format).replace(/[^\d.-]/g, '')}
													data-format={r.slider.format}
													aria-label={r.label}
												/>
											</>
										)}
										{r.kind === 'menu' && r.choices && (
											<select
												class:list={['field', { changed: step && step.value !== r.choices[Number(r.default ?? 0)] }]}
												aria-label={r.label}
											>
												{r.choices.map((c, j) => (
													<option selected={step ? c === step.value : j === r.default}>{c}</option>
												))}
											</select>
										)}
										{r.kind === 'text' && (
											<button type="button" class="click caps" aria-label={`Click ${r.label}`}>
												<span>Click</span>
											</button>
										)}
										</span>
									</div>
								);
							})}
						</div>
					))
				}
			</div>
		</div>
		<div class="info" aria-live="off">
			<p class="help" data-help-text>{first.help}</p>
			<p class="facts caps" data-facts>
				<span>Selector <code data-selector>{first.label}</code></span>
				<span>Type <b data-type-text>{kinds[first.kind]}</b></span>
				<span data-allows-text>{allows(first)}</span>
			</p>
		</div>
	</div>

	<div class="file">
		<div class="file-head">
			<p class="path"><span>McmRecorder/<wbr />My&nbsp;Settings/<wbr /></span><b>0001_WeaponThrowVR.json</b></p>
		</div>
		<pre data-file><code set:html={stepFile(menu.name, steps)} /></pre>
		<p class="file-foot">
			Every label is spelled exactly the way the mod spells it, typos and all. (This is only a demo, of course. Nothing is actually messing with your files right now.)
		</p>
		<p class="visually-hidden" aria-live="polite" data-said></p>
	</div>
	</div>
	<div class="foot">
		<nav class="keys caps" aria-label="Keys that work in this menu">
			<button type="button" data-hint="move"><kbd>↑</kbd><kbd>↓</kbd>Move</button>
			<button type="button" data-hint="space" data-for="toggle"><kbd>Space</kbd>On / off</button>
			<button type="button" data-hint="space" data-for="text"><kbd>Space</kbd>Click</button>
			<button type="button" data-hint="enter" data-for="slider"><kbd>Enter</kbd>Apply</button>
			<button type="button" data-hint="again"><kbd>R</kbd>Start over</button>
		</nav>
	</div>
	</div>
</div>

<script>
	import { stepFile, type Step, type Kind } from '../lib/steps';

	const demo = document.querySelector<HTMLElement>('[data-demo]');
	if (demo) {
		const mod = demo.dataset.mod!;
		const initial: Step[] = JSON.parse(demo.dataset.steps ?? '[]');
		let steps: Step[] = initial.map((s) => ({ ...s }));
		const code = demo.querySelector<HTMLElement>('[data-file] code')!;
		const pre = demo.querySelector<HTMLElement>('[data-file]')!;
		const said = demo.querySelector<HTMLElement>('[data-said]')!;
		const count = demo.querySelector<HTMLElement>('[data-count]')!;

		// The lamp's count, with the same small rise Save makes in the app as
		// each change lands.
		function counted() {
			count.textContent = String(steps.length);
			count.classList.remove('landed');
			void count.offsetWidth;
			count.classList.add('landed');
		}

		const pageOf = (row: HTMLElement) => row.closest<HTMLElement>('[data-grid]')!.dataset.name!;
		const decimals = (n: number) => (String(n).split('.')[1] ?? '').length;

		// write puts the option's step in the draft, in place if it's already
		// there, and shows the file with that step lit.
		function write(row: HTMLElement, kind: Kind, value: string | number, words: string) {
			const page = pageOf(row);
			const option = row.dataset.label!;
			let at = steps.findIndex((s) => s.page === page && s.option === option);
			if (at < 0) {
				steps.push({ page, option, kind, value });
				at = steps.length - 1;
			} else {
				steps[at] = { page, option, kind, value };
			}
			row.classList.add('rec');
			render(at);
			counted();
			said.textContent = `Step ${at + 1} of ${steps.length}: ${option}, ${words}.`;
		}

		function render(lit = -1) {
			code.innerHTML = stepFile(mod, steps);
			const el = code.querySelector<HTMLElement>(`[data-step="${lit}"]`);
			if (!el) return;
			el.classList.add('fresh');
			// Scroll the file, never the page.
			const top = el.offsetTop - pre.clientHeight / 2 + el.offsetHeight / 2;
			pre.scrollTo({ top, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
		}

		// The selected option: the diamond and the haze, and its help and
		// selector under the menu, as SkyUI shows its info text.
		const help = demo.querySelector<HTMLElement>('[data-help-text]')!;
		const selector = demo.querySelector<HTMLElement>('[data-selector]')!;
		const typeText = demo.querySelector<HTMLElement>('[data-type-text]')!;
		const allowsText = demo.querySelector<HTMLElement>('[data-allows-text]')!;
		function select(row: HTMLElement) {
			if (row.classList.contains('sel')) return;
			demo!.querySelectorAll('.row.sel').forEach((r) => r.classList.remove('sel'));
			row.classList.add('sel');
			demo!.dataset.kind = row.dataset.kind; // the strip shows this kind's keys
			help.textContent = row.dataset.help || 'This option has no help text.';
			selector.textContent = row.dataset.label!;
			typeText.textContent = row.dataset.type!;
			allowsText.textContent = row.dataset.allows!;
		}

		demo.addEventListener('focusin', (e) => {
			const row = (e.target as HTMLElement).closest<HTMLElement>('.row');
			if (row) select(row);
		});
		demo.addEventListener('click', (e) => {
			const t = e.target as HTMLElement;
			const row = t.closest<HTMLElement>('.row');
			if (!row) return;
			select(row);
			// A click anywhere on a row that only clicks or switches does it.
			const sw = row.querySelector<HTMLButtonElement>('.switch, .click');
			if (sw && !t.closest('button')) sw.click();
		});

		// Toggles: an option not recorded yet is dimmed, and its first click
		// turns it on.
		demo.querySelectorAll<HTMLButtonElement>('.switch').forEach((b) =>
			b.addEventListener('click', () => {
				const on = b.classList.contains('unset') ? true : b.getAttribute('aria-checked') !== 'true';
				b.classList.remove('unset');
				b.setAttribute('aria-checked', String(on));
				write(b.closest('.row')!, 'toggle', on ? 'on' : 'off', on ? 'on' : 'off');
			})
		);

		// Sliders: the knob moves the number as it goes and records where it's
		// let go; the number records on Enter or leaving it. Copper when it
		// differs from the mod's default.
		demo.querySelectorAll<HTMLElement>('.row[data-kind="slider"]').forEach((row) => {
			const range = row.querySelector<HTMLInputElement>('.range')!;
			const num = row.querySelector<HTMLInputElement>('.num')!;
			const step = Number(num.step);
			const fix = (n: number) => {
				const min = Number(num.min);
				const max = Number(num.max);
				const snapped = min + Math.round((Math.min(max, Math.max(min, n)) - min) / step) * step;
				return Number(snapped.toFixed(Math.max(decimals(step), decimals(min))));
			};
			const commit = (n: number) => {
				if (Number.isNaN(n)) return;
				const v = fix(n);
				const format = num.dataset.format ?? '';
				const places = /\{(\d)\}/.exec(format);
				num.value = places ? v.toFixed(Number(places[1])) : String(v);
				range.value = String(v);
				const d = row.dataset.default;
				num.classList.toggle('changed', d !== undefined && Number(d) !== v);
				write(row, 'slider', v, num.value);
			};
			range.addEventListener('input', () => (num.value = range.value));
			range.addEventListener('change', () => commit(Number(range.value)));
			num.addEventListener('change', () => commit(Number(num.value)));
			num.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') commit(Number(num.value));
			});
		});

		// Menus: the chosen entry's text, as the menu holds it.
		demo.querySelectorAll<HTMLSelectElement>('.row select').forEach((s) =>
			s.addEventListener('change', () => {
				const row = s.closest<HTMLElement>('.row')!;
				s.classList.toggle('changed', s.selectedIndex !== Number(row.dataset.default ?? 0));
				write(row, 'choose', s.value, s.value);
			})
		);

		// Text options can only be clicked, so a step clicks them.
		demo.querySelectorAll<HTMLButtonElement>('.click').forEach((b) =>
			b.addEventListener('click', () => write(b.closest('.row')!, 'click', '', 'clicked'))
		);

		// The page list.
		const pages = demo.querySelectorAll<HTMLButtonElement>('[data-page]');
		const grids = demo.querySelectorAll<HTMLElement>('[data-grid]');
		const options = demo.querySelector<HTMLElement>('[data-options]')!;
		pages.forEach((b) =>
			b.addEventListener('click', () => {
				pages.forEach((p) => p.removeAttribute('aria-current'));
				b.setAttribute('aria-current', 'page');
				grids.forEach((g) => (g.hidden = g.dataset.grid !== b.dataset.page));
				options.scrollTop = 0;
				const grid = grids[Number(b.dataset.page)];
				const row = grid.querySelector<HTMLElement>('.row');
				if (row) select(row);
			})
		);

		// Up and down move between options, in the column the keys are in,
		// from any control that doesn't use the arrows itself.
		demo.addEventListener('keydown', (e) => {
			const t = e.target as HTMLElement;
			if ((e.key !== 'ArrowUp' && e.key !== 'ArrowDown') || !t.matches('.switch, .click')) return;
			const row = t.closest<HTMLElement>('.row')!;
			const col = row.style.getPropertyValue('--c');
			const rows = [...row.parentElement!.querySelectorAll<HTMLElement>('.row')]
				.filter((r) => r.style.getPropertyValue('--c') === col)
				.sort((a, b) => Number(a.style.getPropertyValue('--r')) - Number(b.style.getPropertyValue('--r')));
			const next = rows[rows.indexOf(row) + (e.key === 'ArrowDown' ? 1 : -1)];
			const control = next?.querySelector<HTMLElement>('button, input.num, select');
			if (control) {
				e.preventDefault();
				control.focus();
			}
		});

		// The selected option starts in view, scrolling the menu, never the
		// page, with the list starting on a whole row.
		// Again once the fonts are in, since they change the rows' heights.
		const first = options.querySelector<HTMLElement>('.row.sel');
		const reveal = () => {
			if (!first) return;
			const want = first.offsetTop + first.offsetHeight - options.clientHeight + 16;
			const tops = [...first.parentElement!.children].map((r) => (r as HTMLElement).offsetTop).filter((t) => t >= want);
			const top = Math.min(first.offsetTop, ...tops);
			// The last rows can't scroll to a whole row without room beneath.
			const short = top + options.clientHeight - options.scrollHeight;
			if (short > 0) options.style.paddingBottom = `calc(1rem + ${short}px)`;
			options.scrollTop = top;
		};
		reveal();
		// The rows settle late (fonts, and choice fields sized to their
		// text), so keep the list on a whole row until the visitor takes
		// over.
		let settled = false;
		const settle = () => (settled = true);
		demo.addEventListener('pointerdown', settle, { once: true });
		demo.addEventListener('focusin', settle, { once: true });
		document.fonts?.ready.then(() => settled || reveal());
		if ('ResizeObserver' in window) {
			const grid = first?.parentElement;
			if (grid) new ResizeObserver(() => settled || reveal()).observe(grid);
		}

		// Start over: an empty draft, and every option back to not recorded.
		function again() {
			steps = [];
			demo.querySelectorAll('.row.rec').forEach((r) => r.classList.remove('rec'));
			demo.querySelectorAll<HTMLButtonElement>('.switch').forEach((b) => {
				b.classList.add('unset');
				b.setAttribute('aria-checked', 'false');
			});
			demo.querySelectorAll<HTMLElement>('.row[data-kind="slider"]').forEach((row) => {
				const num = row.querySelector<HTMLInputElement>('.num')!;
				const range = row.querySelector<HTMLInputElement>('.range')!;
				const d = Number(row.dataset.default ?? num.min);
				const places = /\{(\d)\}/.exec(num.dataset.format ?? '');
				num.value = places ? d.toFixed(Number(places[1])) : String(d);
				range.value = String(d);
				num.classList.remove('changed');
			});
			demo.querySelectorAll<HTMLSelectElement>('.row select').forEach((s) => {
				s.selectedIndex = Number(s.closest<HTMLElement>('.row')!.dataset.default ?? 0);
				s.classList.remove('changed');
			});
			render();
			counted();
			said.textContent = 'The draft is empty.';
		}

		// The invitation: it flips the switch it points at, and leaves for
		// good the first time the visitor touches anything in the window.
		const live = document.querySelector<HTMLElement>('[data-live]')!;
		const inviteButton = demo.querySelector<HTMLButtonElement>('[data-invite]');
		const accepted = () => {
			settle(); // the visitor has the list now
			live.classList.add('touched');
			setTimeout(() => inviteButton?.remove(), 400);
		};
		inviteButton?.addEventListener('click', (e) => {
			e.stopPropagation();
			accepted();
			inviteButton.closest<HTMLElement>('.row')!.querySelector<HTMLButtonElement>('.switch')!.click();
		});
		for (const type of ['pointerdown', 'keydown']) demo.addEventListener(type, accepted, { once: true, capture: true });

		// The strip: every hint is a real key, and clicking it does the same.
		// A key runs while focus is inside the window and not in a field.
		const control = () => demo!.querySelector<HTMLElement>('.row.sel button, .row.sel input.num, .row.sel select');
		const acts: Record<string, () => void> = {
			move: () => control()?.focus(),
			space: () => demo!.querySelector<HTMLButtonElement>('.row.sel .switch, .row.sel .click')?.click(),
			enter: () => {
				const num = demo!.querySelector<HTMLInputElement>('.row.sel input.num');
				if (num) num.dispatchEvent(new Event('change'));
			},
			again
		};
		function press(hint: string) {
			demo!.querySelectorAll<HTMLElement>(`[data-hint="${hint}"]`).forEach((b) => {
				b.classList.remove('pressed');
				void b.offsetWidth;
				b.classList.add('pressed');
			});
		}
		demo.querySelectorAll<HTMLButtonElement>('[data-hint]').forEach((b) =>
			b.addEventListener('click', () => {
				press(b.dataset.hint!);
				acts[b.dataset.hint!]();
			})
		);
		demo.addEventListener('keydown', (e) => {
			if (e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented) return;
			const t = e.target as HTMLElement;
			if (/^(INPUT|SELECT|TEXTAREA)$/.test(t.tagName)) return;
			if (e.key.toLowerCase() === 'r') {
				e.preventDefault();
				press('again');
				again();
			} else if (e.key === ' ' && t.matches('.switch, .click')) {
				press('space'); // the button itself does the clicking
			}
		});
	}
</script>

<style>
	/* The app's window, running, in front of the page: outlined in the
	   invitation's rose, since it's the thing to touch, and lifted as the
	   app lifts what floats. */
	.live {
		position: relative;
		border: 1px solid var(--invite);
		border-radius: var(--radius);
		box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.45);
	}
	.demo {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--ground);
	}

	/* The invitation: a rose chip in a row, arriving after a beat and
	   nudging toward its switch, gone once the visitor touches anything. */
	.invite {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
